# ---- 环境与密钥 ----
.env
.venv/
venv/
env/

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- 运行产物 ----
reports/*
!reports/.gitkeep
*.log

# ---- 模型缓存 ----
.cache/
models/

# ---- 团队协作数据（不入库） ----
.codebuddy/teams/
# 阿灯↔阿锤协作留言板：内部流程碎碎念，只在本机用，不入库（2026-10-01 拍板）
TEAM_NOTES.md

# ---- 看板构建产物 / 覆盖率 ----
dashboard/dist/
.coverage

# ---- Agent 评测运行产物（agent_eval/）----
# 轨迹：每题每遍一份、含完整模型输入输出，体积大且每次跑都新增，不入库。
agent_eval/trajectories/
# HTML 报告：make_report.py 的生成物，类比 dashboard/dist/，默认不入库；
# 只留一份样例（repeat=3 那次）在仓库里，让人不跑也能看到报告长什么样。
agent_eval/reports/*.html
!agent_eval/reports/agent-eval-20261001-103426.html
# 结果：正式结果与 INVALID 作废存档都入库（INVALID 是事故留档＝治理证据），
# 只有 results/archive/ 的历史正式结果不入库——它们随时能重跑，且会被
# run_eval.py 自动往里堆，进库只会无限膨胀。
# 详见 agent_eval/results/README.md
agent_eval/results/archive/

# ---- RAG 评测运行产物（rag_eval/）----
# 与 Agent 层同款约定：最新一份正式结果入库（供看板读取），
# results/archive/ 的历史结果不入库（随时能重跑，进库只会无限膨胀）。
rag_eval/results/archive/
# 检索层结果（--retrieval-only 的产物）：不调模型、随时能重跑，不入库。
rag_eval/results/retrieval-*.json
