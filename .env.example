# 复制此文件为 .env，填入你自己的 Key。
# .env 已被 .gitignore 忽略，不会提交到仓库。

# DeepSeek  https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# 阿里云百炼（通义千问）https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=

# 智谱 AI  https://open.bigmodel.cn/
ZHIPU_API_KEY=

# 如果你走聚合网关（如 one-api / new-api），把上面的变量留空，
# 改用这个变量，并在 configs/models.yaml 里把 api_key_env 改成 AGGREGATOR_API_KEY
AGGREGATOR_API_KEY=
